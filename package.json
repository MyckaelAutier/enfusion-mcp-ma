{
  "name": "enfusion-mcp-ma",
  "version": "0.13.1",
  "type": "module",
  "description": "MCP server for Arma Reforger 1.8 modding: API + game data knowledge, headless compile/pack, game & dedicated server control, economy/config overrides",
  "bin": {
    "enfusion-mcp-ma": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "tuning-server": "tsx src/tuning-server/index.ts",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:remote": "tsx scripts/scrape.ts --source remote",
    "scrape:local": "tsx scripts/scrape.ts --source local",
    "check:recipes": "tsx scripts/check-recipes.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "adm-zip": "^0.5.16",
    "cheerio": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "data",
    "!data/wiki/export.xml",
    "mod",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MyckaelAutier/enfusion-mcp-ma.git"
  },
  "homepage": "https://github.com/MyckaelAutier/enfusion-mcp-ma",
  "license": "MIT",
  "keywords": [
    "mcp",
    "arma-reforger",
    "enfusion",
    "modding",
    "model-context-protocol",
    "workbench",
    "dedicated-server",
    "claude"
  ]
}
